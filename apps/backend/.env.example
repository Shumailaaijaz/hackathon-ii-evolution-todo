# FastAPI Backend Environment Variables
# ========================================
# Copy this file to .env and customize values

# Database Configuration
# Neon PostgreSQL connection string format:
# postgresql://user:password@ep-name-region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Better Auth Secret (must match frontend!)
# CRITICAL: This MUST be identical to BETTER_AUTH_SECRET in apps/frontend/.env.local
# Minimum 32 characters for production
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-change-this-min-32-characters-for-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS Configuration
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
# Multiple origins: http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Application Configuration
ENVIRONMENT=development
DEBUG=True

# Optional: Sentry for error tracking
# SENTRY_DSN=

# Optional: Logging
# LOG_LEVEL=INFO
