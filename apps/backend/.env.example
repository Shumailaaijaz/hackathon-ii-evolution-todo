# ============================================================================
# FastAPI Backend Environment Variables
# ============================================================================
# Copy this file to .env and customize values
# Never commit .env to version control!

# ============================================================================
# Database Configuration
# ============================================================================
# Neon PostgreSQL connection string format:
# postgresql://user:password@ep-name-region.neon.tech/dbname?sslmode=require
#
# Example with pooler (recommended for production):
# postgresql://user:password@ep-name-region.aws.neon.tech/dbname?sslmode=require
#
# For local PostgreSQL:
# postgresql://user:password@localhost:5432/todo_dev
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ============================================================================
# Authentication & Security
# ============================================================================
# Better Auth Secret (must match frontend!)
# CRITICAL: This MUST be identical to BETTER_AUTH_SECRET in apps/frontend/.env.local
# Minimum 32 characters for production security
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-change-this-min-32-characters-for-production

# JWT Configuration
# Algorithm for token signing (HS256 is standard)
JWT_ALGORITHM=HS256

# Token expiration in days (7 = 1 week)
JWT_EXPIRE_DAYS=7

# ============================================================================
# CORS Configuration
# ============================================================================
# Allowed origins for cross-origin requests
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
# Multiple origins (comma-separated): http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, or production
ENVIRONMENT=development

# Enable debug mode (verbose logging, auto-reload, detailed errors)
DEBUG=True

# API route prefix (default: /api)
# API_PREFIX=/api

# Application name (for OpenAPI docs)
# PROJECT_NAME=Todo API

# API version
# VERSION=2.0.0

# ============================================================================
# Logging & Monitoring
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Sentry DSN for error tracking
# Sign up at https://sentry.io to get your DSN
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# Development Notes
# ============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update DATABASE_URL with your Neon PostgreSQL credentials
# 3. Generate a secure BETTER_AUTH_SECRET: openssl rand -base64 32
# 4. Update CORS_ORIGINS to match your frontend URL
# 5. Never commit .env to version control (.gitignore should exclude it)
