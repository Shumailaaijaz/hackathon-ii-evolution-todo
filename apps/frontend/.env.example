# Next.js Frontend Environment Variables
# =========================================
# Copy this file to .env.local and customize values

# Backend API URL
# Local development: http://localhost:8000
# Production: https://your-backend.railway.app or https://your-backend.render.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth Secret (must match backend!)
# CRITICAL: This MUST be identical to BETTER_AUTH_SECRET in apps/backend/.env
# Minimum 32 characters for production
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-change-this-min-32-characters-for-production

# Environment
NODE_ENV=development

# Optional: Analytics, monitoring, etc.
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=
