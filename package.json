{
  "name": "todo-fullstack-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Phase II Full-Stack Todo Application - Evolution of Todo",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:backend": "cd apps/backend && uvicorn app.main:app --reload --port 8000",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd apps/frontend && npm test",
    "test:backend": "cd apps/backend && pytest",
    "build": "npm run build:frontend",
    "build:frontend": "cd apps/frontend && npm run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd apps/frontend && npm run lint",
    "lint:backend": "cd apps/backend && ruff check ."
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/todo-fullstack-monorepo.git"
  },
  "keywords": [
    "todo",
    "fullstack",
    "nextjs",
    "fastapi",
    "postgresql",
    "better-auth",
    "monorepo"
  ],
  "author": "",
  "license": "MIT"
}
