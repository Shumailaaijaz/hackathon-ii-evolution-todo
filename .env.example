# Evolution of Todo - Phase II Environment Variables
# ====================================================
# CRITICAL: This file contains example values. Copy to .env and customize.
# DO NOT commit .env files to version control!

# Shared Authentication Secret
# IMPORTANT: Must be identical in both frontend and backend .env files!
# Minimum 32 characters for production security
BETTER_AUTH_SECRET=your-secret-key-change-this-min-32-characters-for-production

# Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=True

# Notes:
# - Generate secure secret: openssl rand -base64 32
# - Frontend needs: NEXT_PUBLIC_API_URL, BETTER_AUTH_SECRET
# - Backend needs: DATABASE_URL, BETTER_AUTH_SECRET, JWT_ALGORITHM, JWT_EXPIRE_DAYS, CORS_ORIGINS
# - See apps/frontend/.env.example and apps/backend/.env.example for complete lists
